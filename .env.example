# PostgreSQL — used for development, test, and production (see config/database.yml).
# Copy to .env and set your real URL. Never commit .env.
#
# Neon: Project dashboard → Connection string → URI (use the pooler host for serverless).
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Local / CI (example):
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/contentforge_1344_rails_development
#
# Kamal / Docker Hub (deploy) — Personal Access Token from hub.docker.com → Account Settings → Security
# KAMAL_REGISTRY_PASSWORD=dckr_pat_...

DATABASE_URL="database_url"

# --- Outbound email (SMTP) — mail.1344.fr, SMTPS port 465
# IMAP (993) is for mail clients only; Rails uses SMTP to send.
# SMTP_ADDRESS=mail.1344.fr
# SMTP_PORT=465
# SMTP_USER_NAME=noreply@1344.fr
# SMTP_PASSWORD=your_smtp_password
# MAILER_FROM="ContentForge <noreply@1344.fr>"
#
# Optional: raise SMTP errors in production (debugging)
# MAILER_RAISE_DELIVERY_ERRORS=true
#
# Browser calls from external sites to /api/* — comma-separated origins, or * for any
# CORS_ALLOWED_ORIGINS=https://arm-services.fr,https://www.arm-services.fr
# CORS_ALLOWED_ORIGINS=*
