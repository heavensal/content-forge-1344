# Copy to .env. Never commit .env.

DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Sidekiq. Local Redis, or the Kamal accessory hostname in production.
REDIS_URL=redis://127.0.0.1:6379/0

# Outbound email (mail.1344.fr — SMTPS 465). IMAP 993 is for clients only.
SMTP_ADDRESS=mail.1344.fr
SMTP_PORT=465
SMTP_USER_NAME=noreply@1344.fr
SMTP_PASSWORD=
MAILER_FROM="Forge <noreply@1344.fr>"

# Origins allowed to call the JSON API from the browser (comma-separated, or *).
CORS_ALLOWED_ORIGINS=*

# MCP is off until the OAuth flow has been tested. Forge uses Devise as its
# authorization server; no separate identity provider or OAuth secrets are required.
MCP_ENABLED=false
MCP_RESOURCE_URL=https://forge.1344.fr/mcp
# Optional exact browser origins (comma separated); absent Origin is accepted.
MCP_ALLOWED_ORIGINS=https://chatgpt.com,http://localhost:6274

# Cloudinary. Images are stored as forge/<normalized-website-name>/<image-id>.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
