<div class="flex flex-col gap-2 text-center text-sm">
  <%- if controller_name != "sessions" %>
    <%= link_to t("user.sign_in"), new_session_path(resource_name), class: "text-emerald-500/90 hover:text-emerald-400" %>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to t("user.create_an_account"), new_registration_path(resource_name), class: "text-zinc-400 hover:text-zinc-200" %>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != "passwords" && controller_name != "registrations" %>
    <%= link_to t("user.forgot_password"), new_password_path(resource_name), class: "text-zinc-500 hover:text-zinc-300" %>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != "confirmations" %>
    <%= link_to t("user.resend_confirmation"), new_confirmation_path(resource_name), class: "text-zinc-500 hover:text-zinc-300" %>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != "unlocks" %>
    <%= link_to t("user.resend_unlock"), new_unlock_path(resource_name), class: "text-zinc-500 hover:text-zinc-300" %>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <%= button_to t("user.sign_in_with", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: secondary_button_classes %>
    <% end %>
  <% end %>
</div>
