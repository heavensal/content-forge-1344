<% content_for :title, t("user.account_title") %>

<div class="mx-auto w-full max-w-xl">
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-50"><%= t("user.title") %></h1>
  <p class="mt-1 text-sm text-zinc-500"><%= t("user.account_hint") %></p>

  <div class="<%= content_section_card_classes %> mt-8">
    <h2 class="text-sm font-semibold text-zinc-100"><%= t("user.language") %></h2>
    <p class="mt-1 text-sm text-zinc-500"><%= t("user.language_hint") %></p>
    <div class="mt-4 max-w-xs">
      <%= render "shared/locale_switcher" %>
    </div>
  </div>

  <div class="<%= content_section_card_classes %> mt-8">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :name, t("user.name"), class: label_classes %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name", class: input_classes, required: true %>
      </div>

      <div>
        <%= f.label :email, t("user.email"), class: label_classes %>
        <%= f.email_field :email, autocomplete: "email", class: input_classes %>
      </div>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="text-sm text-amber-400/90"><%= t("user.pending_confirmation", email: resource.unconfirmed_email) %></p>
      <% end %>

      <div class="border-t border-zinc-800 pt-5">
        <p class="text-xs font-semibold uppercase tracking-wider text-zinc-500"><%= t("user.change_password") %></p>
        <p class="mt-1 text-xs text-zinc-600"><%= t("user.leave_blank") %></p>
      </div>

      <div>
        <%= f.label :password, t("user.password"), class: label_classes %>
        <%= f.password_field :password, autocomplete: "new-password", class: input_classes %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-zinc-500"><%= t("user.minimum", count: @minimum_password_length) %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, t("user.password_confirmation"), class: label_classes %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_classes %>
      </div>

      <div>
        <%= f.label :current_password, t("user.current_password"), class: label_classes %>
        <%= f.password_field :current_password, autocomplete: "current-password", class: input_classes %>
        <p class="mt-1 text-xs text-zinc-500"><%= t("user.current_password_hint") %></p>
      </div>

      <div>
        <%= f.submit t("user.update_account"), class: primary_button_classes %>
      </div>
    <% end %>
  </div>

  <div class="<%= content_section_card_classes %> mt-8">
    <h2 class="text-sm font-semibold text-zinc-100"><%= t("user.chatgpt_access") %></h2>
    <p class="mt-2 text-sm text-zinc-400"><%= t("user.chatgpt_hint") %></p>
    <%= link_to t("user.manage_chatgpt"), settings_mcp_authorizations_path, class: "#{primary_button_classes} mt-4 inline-flex" %>
  </div>

  <div class="<%= content_section_card_classes %> mt-8 border-red-900/30">
    <h2 class="text-sm font-semibold text-red-300"><%= t("user.cancel_account") %></h2>
    <p class="mt-1 text-sm text-zinc-500"><%= t("user.cancel_hint") %></p>
    <%= button_to t("user.cancel_my_account"), registration_path(resource_name), method: :delete, form: { class: "block w-full sm:inline-block", data: { turbo_confirm: t("user.cancel_confirm") } }, class: "#{danger_button_classes} mt-4" %>
  </div>

  <p class="mt-6">
    <%= link_to t("user.back_to_websites"), root_path, class: "text-sm text-emerald-500/90 hover:text-emerald-400" %>
  </p>
</div>
