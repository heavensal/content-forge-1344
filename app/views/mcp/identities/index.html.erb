<% content_for :title, "ChatGPT connection — ContentForge" %>

<div class="mx-auto w-full max-w-2xl">
  <h1 class="text-2xl font-semibold tracking-tight text-zinc-50">ChatGPT connection</h1>
  <p class="mt-2 text-sm text-zinc-400">Keep signing in to contentForge with this account. Link the sign-in you use for ChatGPT so it accesses this contentForge account when you connect the MCP server.</p>

  <div class="<%= content_section_card_classes %> mt-8">
    <h2 class="text-sm font-semibold text-zinc-100">Linked ChatGPT sign-ins</h2>
    <% if @identities.any? %>
      <ul class="mt-4 divide-y divide-zinc-800">
        <% @identities.each do |identity| %>
          <li class="flex items-center justify-between gap-4 py-4">
            <div>
              <p class="text-sm text-zinc-100"><%= URI.parse(identity.issuer).host %></p>
              <p class="mt-1 text-xs text-zinc-500">Connected <%= l(identity.created_at, format: :long) %></p>
            </div>
            <%= button_to "Disconnect", mcp_identity_path(identity), method: :delete, form: { data: { turbo_confirm: "Disconnect this identity? MCP requests for this account will immediately be denied. Remove the contentForge connection in ChatGPT as well." } }, class: danger_button_classes %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="mt-3 text-sm text-zinc-500">No ChatGPT sign-in is linked yet.</p>
    <% end %>

    <% if @provider_configured %>
      <%= button_to "Link my ChatGPT sign-in", new_mcp_identity_path, method: :post, class: "#{primary_button_classes} mt-5" %>
    <% else %>
      <p class="mt-5 rounded-lg border border-amber-800/50 bg-amber-950/20 p-3 text-sm text-amber-200">This connection will be available after the sign-in provider is configured.</p>
    <% end %>
  </div>

  <div class="<%= content_section_card_classes %> mt-6">
    <h2 class="text-sm font-semibold text-zinc-100">Then connect ChatGPT</h2>
    <ol class="mt-3 list-inside list-decimal space-y-2 text-sm text-zinc-400">
      <li>In ChatGPT, add a custom MCP server using the contentForge MCP URL.</li>
      <li>Sign in to the same account and approve the requested contentForge access.</li>
      <li>ChatGPT will now act as this contentForge account and can access only its assigned websites.</li>
    </ol>
    <p class="mt-4 text-xs text-zinc-500">Creating or changing content still requires your contentForge review until ChatGPT approval is implemented.</p>
  </div>

  <p class="mt-6"><%= link_to "← Back to account", edit_user_registration_path, class: "text-sm text-emerald-500/90 hover:text-emerald-400" %></p>
</div>
