<% content_for :title, t("mcp.page_title") %>

<div class="mx-auto w-full max-w-3xl">
  <header>
    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-400"><%= t("mcp.eyebrow") %></p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-zinc-50"><%= t("mcp.title") %></h1>
    <p class="mt-2 text-sm leading-6 text-zinc-400"><%= t("mcp.intro") %></p>
  </header>

  <section class="<%= content_section_card_classes %> mt-6" aria-labelledby="mcp-status-title">
    <h2 id="mcp-status-title" class="text-lg font-semibold text-zinc-100"><%= t(@connected ? "mcp.status_connected" : "mcp.status_disconnected") %></h2>
    <p class="mt-2 text-sm leading-6 text-zinc-400"><%= t(@connected ? "mcp.connected_body" : "mcp.disconnected_body") %></p>
    <div class="mt-5">
      <% if @connected %>
        <%= button_to t("mcp.disconnect"), mcp_authorization_path, method: :delete, form: { data: { turbo_confirm: t("mcp.disconnect_confirm") } }, class: danger_button_classes %>
      <% else %>
        <%= link_to t("mcp.connect_chatgpt"), Mcp::Settings::CHATGPT_CONNECTORS_URL, target: "_blank", rel: "noopener noreferrer", class: primary_button_classes %>
      <% end %>
    </div>
    <p class="mt-5 text-xs leading-5 text-zinc-500"><%= t("mcp.footnote") %></p>
  </section>

  <% unless @connected %>
    <section class="<%= content_section_card_classes %> mt-6" aria-labelledby="mcp-setup-title">
      <h2 id="mcp-setup-title" class="text-lg font-semibold text-zinc-100"><%= t("mcp.server_url") %></h2>
      <p class="mt-2 text-sm leading-6 text-zinc-400"><%= t("mcp.server_hint") %></p>
      <code class="mt-4 block overflow-x-auto rounded-lg border border-zinc-700 bg-zinc-950 px-3 py-3 text-sm text-emerald-300"><%= ENV.fetch("MCP_RESOURCE_URL", "https://forge.1344.fr/mcp") %></code>
      <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-zinc-500"><%= t("mcp.plugin") %></p>
      <p class="mt-2 rounded-lg border border-zinc-800 bg-zinc-950/70 px-3 py-3 text-sm text-zinc-300"><%= t("mcp.plugin_body") %></p>
    </section>
  <% end %>
</div>
