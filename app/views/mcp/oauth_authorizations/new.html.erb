<% content_for :title, t("mcp.authorize_title") %>

<div class="mx-auto w-full max-w-2xl">
  <header>
    <p class="text-xs font-semibold uppercase tracking-wider text-emerald-400"><%= t("mcp.authorize_eyebrow") %></p>
    <h1 class="mt-2 text-2xl font-semibold tracking-tight text-zinc-50"><%= t("doorkeeper.authorizations.new.title") %></h1>
    <p class="mt-3 text-sm leading-6 text-zinc-400">
      <%= t("mcp.requesting_html", client: @pre_auth.client.name) %>
    </p>
  </header>

  <section class="<%= content_section_card_classes %> mt-6" aria-labelledby="oauth-permissions-title">
    <h2 id="oauth-permissions-title" class="text-base font-semibold text-zinc-100"><%= t("doorkeeper.authorizations.new.able_to") %></h2>
    <ul class="mt-4 divide-y divide-zinc-800 text-sm text-zinc-300">
      <% @pre_auth.scopes.each do |scope| %>
        <li class="py-3 first:pt-0 last:pb-0"><%= t(scope, scope: [ :doorkeeper, :scopes ]) %></li>
      <% end %>
    </ul>
    <p class="mt-5 border-t border-zinc-800 pt-4 text-xs leading-5 text-zinc-500">
      <%= t("mcp.limited") %>
    </p>
  </section>

  <div class="mt-6 flex flex-col gap-3 sm:flex-row">
    <%= form_tag oauth_authorization_path, method: :post, class: "sm:order-2", data: { turbo: false } do %>
      <%= hidden_field_tag :client_id, @pre_auth.client.uid, id: nil %>
      <%= hidden_field_tag :redirect_uri, @pre_auth.redirect_uri, id: nil %>
      <%= hidden_field_tag :state, @pre_auth.state, id: nil %>
      <%= hidden_field_tag :response_type, @pre_auth.response_type, id: nil %>
      <%= hidden_field_tag :response_mode, @pre_auth.response_mode, id: nil %>
      <%= hidden_field_tag :scope, @pre_auth.scope, id: nil %>
      <%= hidden_field_tag :code_challenge, @pre_auth.code_challenge, id: nil %>
      <%= hidden_field_tag :code_challenge_method, @pre_auth.code_challenge_method, id: nil %>
      <%= hidden_field_tag :resource, params[:resource], id: nil %>
      <%= submit_tag t("doorkeeper.authorizations.buttons.authorize"), class: primary_button_classes %>
    <% end %>
    <%= form_tag oauth_authorization_path, method: :delete, class: "sm:order-1", data: { turbo: false } do %>
      <%= hidden_field_tag :client_id, @pre_auth.client.uid, id: nil %>
      <%= hidden_field_tag :redirect_uri, @pre_auth.redirect_uri, id: nil %>
      <%= hidden_field_tag :state, @pre_auth.state, id: nil %>
      <%= hidden_field_tag :response_type, @pre_auth.response_type, id: nil %>
      <%= hidden_field_tag :response_mode, @pre_auth.response_mode, id: nil %>
      <%= hidden_field_tag :scope, @pre_auth.scope, id: nil %>
      <%= hidden_field_tag :code_challenge, @pre_auth.code_challenge, id: nil %>
      <%= hidden_field_tag :code_challenge_method, @pre_auth.code_challenge_method, id: nil %>
      <%= hidden_field_tag :resource, params[:resource], id: nil %>
      <%= submit_tag t("doorkeeper.authorizations.buttons.deny"), class: secondary_button_classes %>
    <% end %>
  </div>
</div>
