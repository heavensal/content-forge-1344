<div class="<%= content_section_card_classes %> mt-6">
  <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400"><%= t("website_membership.title") %></h2>
  <p class="mt-2 text-sm text-zinc-500"><%= t("website_membership.hint") %></p>

  <% memberships = @website.website_memberships.includes(:user) %>
  <% if memberships.any? %>
    <ul class="mt-4 space-y-3">
      <% memberships.each do |membership| %>
        <li class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <p class="min-w-0 truncate text-sm text-zinc-200"><%= membership.user.email %> · <%= role_label(membership) %></p>
          <%= button_to t("website_membership.remove"), website_membership_path(@website, membership), method: :delete, class: danger_button_classes, form: { class: "sm:w-auto", data: { turbo_confirm: t("website_membership.remove_confirm") } } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-4 text-sm text-zinc-400"><%= t("website_membership.empty") %></p>
  <% end %>

  <%= form_with url: website_memberships_path(@website), class: "mt-6 space-y-4" do %>
    <div>
      <%= label_tag "membership_email", t("website_membership.email"), class: label_classes %>
      <%= email_field_tag :email, nil, required: true, class: input_classes, autocomplete: "off", id: "membership_email" %>
    </div>
    <div>
      <%= label_tag "membership_role", t("website_membership.role"), class: label_classes %>
      <%= select_tag :role, options_for_select(role_options(WebsiteMembership), "owner"), class: input_classes, id: "membership_role" %>
    </div>
    <%= submit_tag t("website_membership.assign"), class: primary_button_classes %>
  <% end %>
</div>
