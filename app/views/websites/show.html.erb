<% content_for :title, "#{@website.name} — Forge" %>

<div class="mx-auto w-full max-w-5xl">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <p class="text-xs font-medium uppercase tracking-wider text-emerald-500/90"><%= t("website.one") %></p>
      <h1 class="mt-1 text-2xl font-semibold tracking-tight text-zinc-50 sm:text-3xl"><%= @website.name %></h1>
      <p class="mt-1 break-all text-emerald-400/90 sm:break-normal"><%= @website.domain %></p>
      <% if @website.email.present? %>
        <p class="mt-1 break-all text-sm text-zinc-400"><%= @website.email %></p>
      <% end %>
      <p class="mt-2 text-sm text-zinc-400"><%= t("website.default_language", language: content_locale_label(@website.default_locale)) %></p>
      <p class="mt-2 inline-flex rounded-full bg-zinc-800 px-2.5 py-0.5 text-xs font-medium text-zinc-400 ring-1 ring-zinc-700"><%= status_label(@website) %></p>
    </div>
    <div class="flex w-full flex-col gap-2 sm:w-auto sm:flex-row sm:flex-wrap">
      <%= link_to t("common.edit"), edit_website_path(@website), class: secondary_button_classes %>
      <%= link_to t("contact_form.title"), website_contact_form_integration_path(@website), class: secondary_button_classes %>
      <%= link_to t("article.heading"), website_articles_path(@website), class: primary_button_classes %>
    </div>
  </div>

  <% if @website.description.present? %>
    <p class="mt-8 max-w-2xl text-sm leading-relaxed text-zinc-400"><%= @website.description %></p>
  <% end %>

  <%= render "client_access" if current_user.admin? %>

  <div class="<%= content_section_card_classes %> mt-10">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400"><%= t("website.show.api_access") %></h2>
    <p class="mt-2 text-sm text-zinc-500"><%= t("website.show.api_help_html") %></p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
      <input type="text" readonly value="<%= @website.api_token %>" class="<%= input_classes %> min-w-0 font-mono text-xs sm:flex-1 sm:text-sm" id="website-api-token" onclick="this.select()" aria-label="<%= t("website.show.api_token") %>" />
      <button type="button" class="<%= secondary_button_classes %> shrink-0" onclick="navigator.clipboard.writeText(document.getElementById('website-api-token').value)">
        <%= t("website.show.copy_token") %>
      </button>
    </div>
    <p class="mt-3 text-xs text-zinc-600"><%= t("website.show.api_secret") %></p>
  </div>

  <div class="<%= content_section_card_classes %> mt-6">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-zinc-400"><%= t("website.show.rebuild") %></h2>
    <p class="mt-2 text-sm text-zinc-500"><%= t("website.show.rebuild_help") %></p>
    <ul class="mt-4 space-y-1 text-sm text-zinc-300">
      <li><%= t("website.show.blog_articles", state: @website.imports_articles? ? t("website.show.imported") : t("website.show.not_imported")) %></li>
      <li><%= t("website.show.faqs", state: @website.imports_faqs? ? t("website.show.imported") : t("website.show.not_imported")) %></li>
      <li><%= t("website.show.reviews", state: @website.imports_reviews? ? t("website.show.imported") : t("website.show.not_imported")) %></li>
    </ul>
    <p class="mt-4 break-all text-sm text-zinc-300"><%= @website.rebuild_webhook_url.presence || t("website.show.no_rebuild_url") %></p>
    <p class="mt-1 text-xs text-zinc-500"><%= @website.rebuild_webhook_token.present? ? t("website.show.bearer_saved") : t("website.show.no_bearer") %></p>
    <p class="mt-4 text-sm text-zinc-500"><%= t("website.show.signature_html") %></p>
    <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
      <input type="text" readonly value="<%= @website.rebuild_webhook_secret %>" class="<%= input_classes %> min-w-0 font-mono text-xs sm:flex-1 sm:text-sm" id="website-rebuild-secret" onclick="this.select()" aria-label="<%= t("website.show.rebuild_secret") %>" />
      <button type="button" class="<%= secondary_button_classes %> shrink-0" onclick="navigator.clipboard.writeText(document.getElementById('website-rebuild-secret').value)">
        <%= t("website.show.copy_secret") %>
      </button>
    </div>
  </div>

  <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <%= link_to website_articles_path(@website), class: "#{content_section_card_classes} block transition hover:border-emerald-500/30 hover:ring-1 hover:ring-emerald-500/20" do %>
      <h3 class="font-semibold text-zinc-100"><%= t("article.heading") %></h3>
      <p class="mt-1 text-sm text-zinc-500"><%= t("article.blog_posts", domain: @website.domain) %></p>
      <p class="mt-4 text-2xl font-semibold text-emerald-400"><%= @website.articles.count %></p>
    <% end %>
    <%= link_to website_faqs_path(@website), class: "#{content_section_card_classes} block transition hover:border-emerald-500/30 hover:ring-1 hover:ring-emerald-500/20" do %>
      <h3 class="font-semibold text-zinc-100"><%= t("faq.title") %></h3>
      <p class="mt-1 text-sm text-zinc-500"><%= t("faq.questions") %></p>
      <p class="mt-4 text-2xl font-semibold text-emerald-400"><%= @website.faqs.count %></p>
    <% end %>
    <%= link_to website_reviews_path(@website), class: "#{content_section_card_classes} block transition hover:border-emerald-500/30 hover:ring-1 hover:ring-emerald-500/20" do %>
      <h3 class="font-semibold text-zinc-100"><%= t("review.title") %></h3>
      <p class="mt-1 text-sm text-zinc-500"><%= t("review.testimonials") %></p>
      <p class="mt-4 text-2xl font-semibold text-emerald-400"><%= @website.reviews.count %></p>
    <% end %>
  </div>
</div>
