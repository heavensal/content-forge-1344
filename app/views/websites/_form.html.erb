<%= render "shared/model_errors", model: website %>

<%= form_with model: website, class: "space-y-6" do |f| %>
  <div>
    <%= f.label :name, t("website.name"), class: label_classes %>
    <%= f.text_field :name, class: input_classes, required: true, autocomplete: "organization" %>
  </div>

  <div>
    <%= f.label :domain, t("website.domain"), class: label_classes %>
    <%= f.text_field :domain, class: input_classes, required: true, placeholder: t("website.placeholders.domain"), autocomplete: "url" %>
    <p class="mt-1 text-xs text-zinc-500"><%= t("website.hints.domain") %></p>
  </div>

  <div>
    <%= f.label :email, t("website.email"), class: label_classes %>
    <%= f.email_field :email, class: input_classes, autocomplete: "email", placeholder: t("website.placeholders.email"), title: t("website.placeholders.email_title"), pattern: "[^@\\s]+@[^@\\s]+" %>
    <p class="mt-1 text-xs text-zinc-500"><%= t("website.hints.email") %></p>
  </div>

  <div>
    <%= f.label :description, t("website.description"), class: label_classes %>
    <%= f.text_area :description, class: "#{input_classes} min-h-[100px]", rows: 4 %>
  </div>

  <div>
    <%= f.label :default_locale, t("website.default_locale"), class: label_classes %>
    <%= f.select :default_locale, content_locale_options, {}, class: input_classes %>
    <p class="mt-1 text-xs text-zinc-500"><%= t("website.hints.default_locale") %></p>
  </div>

  <div>
    <%= f.label :status, t("website.status"), class: label_classes %>
    <%= f.select :status, status_options(Website), {}, class: input_classes %>
  </div>

  <fieldset class="space-y-3">
    <legend class="<%= label_classes %>"><%= t("website.hints.imports_legend") %></legend>
    <p class="text-xs text-zinc-500"><%= t("website.hints.imports") %></p>
    <label class="flex items-center gap-3 text-sm text-zinc-200">
      <%= f.check_box :imports_articles, class: "size-4 rounded border-zinc-600 bg-zinc-900 text-emerald-500 focus:ring-emerald-500/40" %>
      <%= t("website.imports_articles") %>
    </label>
    <label class="flex items-center gap-3 text-sm text-zinc-200">
      <%= f.check_box :imports_faqs, class: "size-4 rounded border-zinc-600 bg-zinc-900 text-emerald-500 focus:ring-emerald-500/40" %>
      <%= t("website.imports_faqs") %>
    </label>
    <label class="flex items-center gap-3 text-sm text-zinc-200">
      <%= f.check_box :imports_reviews, class: "size-4 rounded border-zinc-600 bg-zinc-900 text-emerald-500 focus:ring-emerald-500/40" %>
      <%= t("website.imports_reviews") %>
    </label>
  </fieldset>

  <div>
    <%= f.label :rebuild_webhook_url, t("website.rebuild_webhook_url"), class: label_classes %>
    <%= f.url_field :rebuild_webhook_url, class: input_classes, placeholder: t("website.placeholders.rebuild_url"), inputmode: "url" %>
    <p class="mt-1 text-xs text-zinc-500"><%= t("website.hints.rebuild_url") %></p>
  </div>

  <div>
    <%= f.label :rebuild_webhook_token, t("website.rebuild_webhook_token"), class: label_classes %>
    <%= f.password_field :rebuild_webhook_token, class: input_classes, autocomplete: "off", placeholder: website.rebuild_webhook_token.present? ? t("website.hints.rebuild_token_saved") : t("website.hints.rebuild_token_blank") %>
    <p class="mt-1 text-xs text-zinc-500"><%= t("website.hints.rebuild_token") %></p>
  </div>

  <div class="<%= form_footer_actions_classes %> pt-2">
    <%= f.submit class: primary_button_classes %>
    <%= link_to t("common.cancel"), website.persisted? ? website : websites_path, class: secondary_button_classes %>
  </div>
<% end %>
