<div class="flex w-full max-w-xs rounded-lg border border-zinc-700 p-0.5" role="group" aria-label="<%= t("common.language") %>">
  <% I18n.available_locales.each do |locale| %>
    <% active = locale == I18n.locale %>
    <% classes = "inline-flex min-h-9 w-full items-center justify-center rounded-md px-2 py-1 text-xs font-semibold touch-manipulation #{active ? "bg-emerald-500/15 text-emerald-300" : "text-zinc-400 hover:bg-zinc-800 hover:text-zinc-100"}" %>
    <% if active %>
      <span class="min-w-0 flex-1 <%= classes %>" aria-current="true"><%= ui_locale_name(locale) %></span>
    <% else %>
      <%= button_to ui_locale_name(locale), locale_path, method: :patch, params: { locale: locale, return_to: request.fullpath }, class: "#{classes} cursor-pointer border-0 bg-transparent", form: { class: "min-w-0 flex-1" } %>
    <% end %>
  <% end %>
</div>
