<%= render "shared/model_errors", model: faq %>

<%= form_with model: [@website, faq], class: "space-y-6" do |f| %>
  <%= render "shared/locale_field", form: f %>

  <div>
    <%= f.label :question, t("faq.question"), class: label_classes %>
    <%= f.text_field :question, class: input_classes, required: true %>
  </div>

  <div>
    <%= f.label :slug, t("faq.slug"), class: label_classes %>
    <%= f.text_field :slug, class: input_classes %>
    <p class="mt-1 text-xs text-zinc-500"><%= t("faq.hints.slug") %></p>
  </div>

  <div>
    <%= f.label :answer, t("faq.answer"), class: label_classes %>
    <%= f.text_area :answer, class: "#{input_classes} min-h-[140px]", rows: 6 %>
  </div>

  <div>
    <%= f.label :position, t("faq.position"), class: label_classes %>
    <%= f.number_field :position, class: input_classes, min: 0, step: 1 %>
  </div>

  <div>
    <%= f.label :status, t("faq.status"), class: label_classes %>
    <%= f.select :status, status_options(Faq), {}, class: input_classes %>
  </div>

  <div>
    <%= f.label :published_at, t("faq.published_at"), class: label_classes %>
    <%= f.datetime_field :published_at, class: input_classes %>
  </div>

  <div class="<%= form_footer_actions_classes %> pt-2">
    <%= f.submit class: primary_button_classes %>
    <%= link_to t("common.cancel"), faq.persisted? ? [@website, faq] : website_faqs_path(@website), class: secondary_button_classes %>
  </div>
<% end %>
