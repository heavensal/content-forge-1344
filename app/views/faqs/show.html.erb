<% content_for :title, "#{t("faq.one")} — #{@website.name}" %>

<div class="mx-auto w-full max-w-3xl">
  <%= link_to t("faq.back"), website_faqs_path(@website), class: "inline-flex min-h-11 items-center text-sm text-emerald-500/90 touch-manipulation hover:text-emerald-400" %>

  <header class="mt-6">
    <p class="text-xs font-medium uppercase tracking-wider text-zinc-500"><%= content_locale_label(@faq.locale) %> · <%= status_label(@faq) %> · <span class="break-all sm:break-normal"><%= @faq.slug %></span> · <%= t("faq.position_label", position: @faq.position) %></p>
    <h1 class="mt-2 break-words text-xl font-semibold tracking-tight text-zinc-50 sm:text-2xl"><%= @faq.question %></h1>
    <% if @faq.published_at.present? %>
      <p class="mt-2 text-sm text-zinc-500"><%= t("common.published_on", date: l(@faq.published_at, format: :long)) %></p>
    <% end %>
  </header>

  <div class="<%= content_section_card_classes %> mt-8">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500"><%= t("faq.answer") %></h2>
    <div class="mt-3 break-words text-sm leading-relaxed text-zinc-300 whitespace-pre-wrap"><%= @faq.answer.presence || t("common.blank") %></div>
  </div>

  <div class="mt-8 flex flex-col gap-2 sm:flex-row sm:flex-wrap">
    <%= link_to t("common.edit"), edit_website_faq_path(@website, @faq), class: primary_button_classes %>
    <%= link_to t("common.write_other", language: content_locale_label(other_content_locale(@faq.locale))), new_website_faq_path(@website, from: @faq.id, locale: other_content_locale(@faq.locale)), class: secondary_button_classes %>
    <%= button_to t("common.delete"), [@website, @faq], method: :delete, form: { class: "block w-full sm:inline-block", data: { turbo_confirm: t("faq.delete_confirm") } }, class: danger_button_classes %>
  </div>
</div>
